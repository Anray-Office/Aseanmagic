        {
          "value": "flex-start",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "flex-end",
          "label": "右对齐"
        },
        {
          "value": "space-between",
          "label": "两端对齐"
        },
        {
          "value": "space-around",
          "label": "均匀分布"
        }
