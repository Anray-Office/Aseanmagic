    },
    {
      "type": "text",
      "id": "title",
      "label": "标题内容",
      "default": "联系我们"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2",
      "label": "标题标签"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "标题字体大小",
      "default": 28
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "label": "标题字体粗细",
      "default": 700
    },
    {
      "type": "color",
