        {
          "value": "row",
          "label": "横向排列"
        },
        {
          "value": "column",
          "label": "纵向排列"
        }
      ],
      "default": "row",
      "label": "排列方向"
    },
    {
      "type": "select",
      "id": "content_alignment",
