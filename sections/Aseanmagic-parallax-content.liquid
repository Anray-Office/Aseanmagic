{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .rich-text__heading {
    position: relative;
  }

  .rich-text__heading::before {
    content: " ";
    width: 250px;
    border-bottom: 4px dotted #000000;
    position: absolute;
    top: -20px;
    left: 5px;
  }

  .parallax-logo-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin: 40px 0;
  }

  .parallax-logo-item {
    width: 20%;
    padding: 15px;
    text-align: center;
    box-sizing: border-box;
  }

  .parallax-logo-item img {
    max-width: 100%;
    height: auto;
    transition: transform 0.3s ease;
  }

  .parallax-logo-item img:hover {
    transform: scale(1.05);
  }

  @media screen and (max-width: 990px) {
    .parallax-logo-item {
      width: 33.333%;
    }
  }

  @media screen and (max-width: 750px) {
    .parallax-logo-item {
      width: 50%;
    }
    
    .rich-text__heading::before {
      width: 150px;
    }
  }
{%- endstyle -%}

<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
  <div class="parallax-content color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} content-container--full-width{% endif %} section-{{ section.id }}-padding">
    <div class="rich-text__wrapper rich-text__wrapper--{{ section.settings.desktop_content_position }}{% if section.settings.full_width %} page-width{% endif %}">
      <!-- 上部分：标题 -->
      <div class="rich-text__blocks {{ section.settings.content_alignment }}">
        {%- if section.settings.heading != blank -%}
          <h2
            class="rich-text__heading {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        
        {%- if section.settings.subheading != blank -%}
          <div
            class="rich-text__text rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}
      </div>

      <!-- 中部分：Logo -->
      <div class="parallax-logo-container">
        {%- for block in section.blocks -%}
          {%- if block.type == 'logo_item' -%}
            <div class="parallax-logo-item" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.logo_link | default: 'javascript:;' }}">
                {%- if block.settings.logo_image != blank -%}
                  <img
                    srcset="{{ block.settings.logo_image | image_url: width: 100 }} 100w,
                            {{ block.settings.logo_image | image_url: width: 200 }} 200w"
                    src="{{ block.settings.logo_image | image_url: width: 200 }}"
                    alt="{{ block.settings.logo_image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.logo_image.width }}"
                    height="{{ block.settings.logo_image.height }}"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- 下部分：按钮 -->
      <div class="rich-text__blocks {{ section.settings.content_alignment }}">
        <div class="rich-text__buttons{% if section.settings.button_label != blank and section.settings.button_label_2 != blank %} rich-text__buttons--multiple{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if section.settings.button_label != blank -%}
            <a
              {% if section.settings.button_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link }}"
              {% endif %}
              class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
            >
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a
              {% if section.settings.button_link_2 == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link_2 }}"
              {% endif %}
              class="button{% if section.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
            >
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "custom-parallax-content",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "视差内容标题",
      "label": "标题"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "default": "<p>添加描述文字</p>",
      "label": "副标题"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "小号"
        },
        {
          "value": "h1",
          "label": "中号"
        },
        {
          "value": "h0",
          "label": "大号"
        },
        {
          "value": "hxl",
          "label": "特大号"
        },
        {
          "value": "hxxl",
          "label": "超大号"
        }
      ],
      "default": "h1",
      "label": "标题大小"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "left",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中对齐"
        },
        {
          "value": "right",
          "label": "右对齐"
        }
      ],
      "default": "center",
      "label": "桌面端内容位置"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中对齐"
        },
        {
          "value": "right",
          "label": "右对齐"
        }
      ],
      "default": "center",
      "label": "内容对齐方式"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "配色方案",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "全宽显示"
    },
    {
      "type": "header",
      "content": "按钮设置1"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "按钮文字",
      "label": "按钮文字"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "default": false,
      "label": "使用次要按钮样式"
    },
    {
      "type": "header",
      "content": "按钮设置2"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "按钮文字"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "按钮链接"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary_2",
      "default": false,
      "label": "使用次要按钮样式"
    },
    {
      "type": "header",
      "content": "内边距设置"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "顶部内边距",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "底部内边距",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "logo_item",
      "name": "Logo项",
      "limit": 15,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo图片"
        },
        {
          "type": "url",
          "id": "logo_link",
          "label": "Logo链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "custom-parallax-content",
      "blocks": [
        {
          "type": "logo_item"
        },
        {
          "type": "logo_item"
        },
        {
          "type": "logo_item"
        },
        {
          "type": "logo_item"
        },
        {
          "type": "logo_item"
        }
      ]
    }
  ]
}
{% endschema %}
