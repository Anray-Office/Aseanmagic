{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}
{{ 'aseanmagic-common.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    --padding-top-mobile: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  
  /* 移动端标题字体大小 */
  .particle-item {
    --title-font-size: var(--title-mobile-size, 22px);
  }
  
  /* PC端标题字体大小 */
  @media screen and (min-width: 750px) {
    .particle-item {
      --title-font-size: var(--title-desktop-size, 28px);
    }
  }

  .particle-container {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
  }

  .particle-item {
    display: flex;
    flex-direction: column;
    border-radius: 0;
    overflow: hidden;
    height: 100%;
    position: relative;
    background-color: #F8EAE0; /* 默认背景颜色，与图片中肤色调一致 */
  }
  
  .particle-item:not(.particle-text-item) {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  
  .particle-text-item {
    justify-content: center;
    min-height: 300px !important;
  }

  .particle-item__content {
    padding:3.5rem 2rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    background-color: transparent;
    height: 100%;
    justify-content: center;
  }

  .particle-item__logo {
    max-width: 100%;
    margin-bottom: 15px;
  }

  .particle-item .placeholder-svg,
  .particle-item__logo img {
    max-width: 100%;
    max-height:60px;
    object-fit: contain;
  }

  .particle-item__logo img {
    display: block;
  }

  .particle-item__title {
    margin-top: 0;
    margin-bottom: 15px;
    position: relative;
    font-weight: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }
  
  .particle-item__title h1, .particle-item__title h2, .particle-item__title h3,
  .particle-item__title h4, .particle-item__title h5, .particle-item__title h6,
  .particle-item__title p {
    margin: 0;
    font-size: var(--title-font-size);
    font-weight: inherit;
  }

  .particle-item__text {
    margin-bottom: 25px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .particle-layout--vertical .particle-item {
    width: 100%;
    height: 400px;
  }

  .particle-layout--horizontal .particle-item {
    width: calc(50% - 15px);
    min-height: 350px;
  }

  @media screen and (max-width: 749px) {
    .particle-layout--horizontal .particle-item {
      width: 100%;
      height: auto;
    }

    .particle-item__title::before {
      left: -15px;
    }
  }

  /* 按钮样式已移至aseanmagic-common.css */
{%- endstyle -%}

<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
  <div class="content-container color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} content-container--full-width{% endif %} section-{{ section.id }}-padding section-padding">
    <div class="particle-container particle-layout--{{ section.settings.layout_style }}">
      {%- for block in section.blocks -%}
        <div
          id="block-{{ block.id }}"
          class="particle-item{% if block.type == 'text_item' %} particle-text-item{% endif %}"
          style="{% if block.type == 'item' %}background-image: url({% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1500 }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' | escape }}{% endif %});{% else %}background-color: {{ block.settings.bg_color }};{% endif %}
                 --title-desktop-size: {{ block.settings.title_size_desktop | default: 28 }}px;
                 --title-mobile-size: {{ block.settings.title_size_mobile | default: 22 }}px;"
          {{ block.shopify_attributes }}
        >
          <div class="particle-item__content">
            {% if block.type == 'item' %}
            <div class="particle-item__logo-container">
              <div class="particle-item__logo">
                {%- if block.settings.logo != blank -%}
                  {{
                    block.settings.logo
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', alt: block.settings.title
                  }}
                {%- else -%}
                  {{ 'icon-logo.svg' | asset_url | img_tag: loading: 'lazy', alt: block.settings.title }}
                {%- endif -%}
              </div>
              <div class="particle-item__title">
                <{{ block.settings.title_tag | default: 'h3' }}>
                  {{ block.settings.title }}
                </{{ block.settings.title_tag | default: 'h3' }}>
              </div>
            </div>
            {% else %}
            <div class="particle-item__title">
              <{{ block.settings.title_tag | default: 'h3' }}>
                {{ block.settings.title }}
              </{{ block.settings.title_tag | default: 'h3' }}>
            </div>
            {% endif %}
            <div class="particle-item__text rte">
              {{ block.settings.description }}
            </div>
            {%- if block.settings.button_label != blank -%}
              <div class="elementor-button-wrapper">
                {%- if block.settings.use_custom_button -%}
                  <style>
                    #custom-btn-{{ block.id }} {
                      color: {{ block.settings.custom_text_color }};
                      background-color: {{ block.settings.custom_bg_color }};
                    }
                    #custom-btn-{{ block.id }}:hover {
                      color: {{ block.settings.custom_hover_text_color }};
                      background-color: {{ block.settings.custom_hover_bg_color }};
                    }
                    #custom-btn-{{ block.id }} rect {
                      stroke: {{ block.settings.custom_border_color }};
                      stroke-width: {{ block.settings.custom_border_width }}px;
                    }
                    #custom-btn-{{ block.id }}:hover rect {
                      stroke: {{ block.settings.custom_hover_border_color }};
                    }
                  </style>

                  <a
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                    id="custom-btn-{{ block.id }}"
                    class="custom-btn"
                  >
                    <svg>
                      <rect x="0" y="0" fill="none" width="100%" height="100%"/>
                    </svg>
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- else -%}
                  <a
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                      {%- if block.settings.open_in_new_tab -%}target="_blank"{%- endif -%}
                    {% endif %}
                    class="elementor-button"
                  >
                    <span class="elementor-button-text">{{ block.settings.button_label | escape }}</span>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

