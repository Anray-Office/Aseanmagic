{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    
    {% for block in section.blocks %}
    #block-{{ block.id }} .particle-item__title {
      font-size: {{ block.settings.title_size_desktop }}px;
    }
    {% endfor %}
  }

  .particle-container {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
  }

  .particle-item {
    display: flex;
    flex-direction: column;
    border-radius: 0;
    overflow: hidden;
    height: 100%;
    position: relative;
    background-color: #F8EAE0; /* 默认背景颜色，与图片中肤色调一致 */
  }
  
  .particle-item:not(.particle-text-item) {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  
  .particle-text-item {
    justify-content: center;
    height: 300px !important;
  }

  .particle-item__content {
    padding:3.5rem 2rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    background-color: transparent;
    height: 100%;
    justify-content: center;
  }

  .particle-item__logo {
    max-width: 100%;
    margin-bottom: 15px;
  }

  .particle-item .placeholder-svg,
  .particle-item__logo img {
    max-width: 100%;
    max-height:60px;
    object-fit: contain;
  }

  .particle-item__logo img {
    display: block;
  }

  .particle-item__title {
    margin-top: 0;
    margin-bottom: 15px;
    position: relative;
    font-weight: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }

  .particle-item__text {
    margin-bottom: 25px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .particle-layout--vertical .particle-item {
    width: 100%;
    height: 400px;
  }

  .particle-layout--horizontal .particle-item {
    width: calc(50% - 15px);
    height: 350px;
  }

  @media screen and (max-width: 749px) {
    .particle-layout--horizontal .particle-item {
      width: 100%;
      height: auto;
      min-height: 350px;
    }

    .particle-item__title::before {
      left: -15px;
    }
  }

  /* 自定义按钮样式 */
  .custom-btn {
    cursor: pointer;
    color: #000000;
    background-color: transparent;
    display: inline-block;
    font-size: 16px;
    font-weight: 400;
    line-height: 45px;
    max-width: 160px;
    position: relative;
    text-decoration: none;
    text-transform: uppercase;
    width: 100%;
    text-align: center;
    transition-property: all;
    transition-duration: .25s;
    transition-timing-function: ease;
  }

  .custom-btn:hover {
    text-decoration: none;
    color: #000000;
    background-color: transparent;
  }

  .custom-btn svg {
    height: 45px;
    left: 0;
    position: absolute;
    top: 0;
    width: 100%;
    transition-property: all;
    transition-duration: .25s;
    transition-timing-function: ease;
  }

  .custom-btn rect {
    fill: none;
    stroke: #000000;
    stroke-width: 2;
    stroke-dasharray: 422, 0;
    transition: all 0.35s linear;
  }

  .custom-btn:hover {
    font-weight: 900;
    letter-spacing: 1px;
  }

  .custom-btn:hover rect {
    stroke: #000000;
    stroke-width: 5;
    stroke-dasharray: 15, 310;
    stroke-dashoffset: 48;
    transition: all 1.35s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .custom-btn {
    padding: 0;
  }

  /* elementor 按钮样式 */
  .elementor-button-wrapper {
    margin-top: 5px;
    display: inline-block;
  }

  .elementor-button {
    cursor: pointer;
    display: inline-block;
    background-color: #C02026;
    color: #ffffff;
    padding: 10px 30px;
    border-radius: 0;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    text-transform: none;
    text-align: center;
    transition: all 0.3s ease;
    box-shadow: 2px 2px 5px rgba(0,0,0,0.2);
    position: relative;
    line-height: 1.5;
    border: none;
  }

  .elementor-button:hover {
    background-color: #A01B20;
    color: #ffffff;
    text-decoration: none;
  }
{%- endstyle -%}

<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
  <div class="content-container color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} content-container--full-width{% endif %} section-{{ section.id }}-padding">
    <div class="particle-container particle-layout--{{ section.settings.layout_style }}">
      {%- for block in section.blocks -%}
        <div
          id="block-{{ block.id }}"
          class="particle-item{% if block.type == 'text_item' %} particle-text-item{% endif %}"
          style="{% if block.type == 'item' %}background-image: url({% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1500 }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' | escape }}{% endif %});{% else %}background-color: {{ block.settings.bg_color }};{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="particle-item__content">
            {% if block.type == 'item' %}
            <div class="particle-item__logo-container">
              <div class="particle-item__logo">
                {%- if block.settings.logo != blank -%}
                  {{
                    block.settings.logo
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', alt: block.settings.title
                  }}
                {%- else -%}
                  {{ 'icon-logo.svg' | asset_url | img_tag: loading: 'lazy', alt: block.settings.title }}
                {%- endif -%}
              </div>
              <div class="particle-item__title" style="font-size: {{ block.settings.title_size_mobile }}px;">
                {{ block.settings.title }}
              </div>
            </div>
            {% else %}
            <div class="particle-item__title" style="font-size: {{ block.settings.title_size_mobile }}px;">
              {{ block.settings.title }}
            </div>
            {% endif %}
            <div class="particle-item__text rte">
              {{ block.settings.description }}
            </div>
            {%- if block.settings.button_label != blank -%}
              <div class="elementor-button-wrapper">
                {%- if block.settings.use_custom_button -%}
                  <style>
                    #custom-btn-{{ block.id }} {
                      color: {{ block.settings.custom_text_color }};
                      background-color: {{ block.settings.custom_bg_color }};
                    }
                    #custom-btn-{{ block.id }}:hover {
                      color: {{ block.settings.custom_hover_text_color }};
                      background-color: {{ block.settings.custom_hover_bg_color }};
                    }
                    #custom-btn-{{ block.id }} rect {
                      stroke: {{ block.settings.custom_border_color }};
                      stroke-width: {{ block.settings.custom_border_width }}px;
                    }
                    #custom-btn-{{ block.id }}:hover rect {
                      stroke: {{ block.settings.custom_hover_border_color }};
                    }
                  </style>

                  <a
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                    id="custom-btn-{{ block.id }}"
                    class="custom-btn"
                  >
                    <svg>
                      <rect x="0" y="0" fill="none" width="100%" height="100%"/>
                    </svg>
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- else -%}
                  <a
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                      {%- if block.settings.open_in_new_tab -%}target="_blank"{%- endif -%}
                    {% endif %}
                    class="elementor-button"
                  >
                    <span class="elementor-button-text">{{ block.settings.button_label | escape }}</span>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "custom-particle-image",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "options": [
        {
          "value": "vertical",
          "label": "纵向排列"
        },
        {
          "value": "horizontal",
          "label": "横向排列"
        }
      ],
      "default": "horizontal",
      "label": "排列方式"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "全宽显示"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "配色方案",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "内边距设置"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "顶部内边距",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "底部内边距",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "图片展示项",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "背景图片"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo 图片"
        },
        {
          "type": "text",
          "id": "title",
          "default": "标题文本",
          "label": "标题"
        },
        {
          "type": "range",
          "id": "title_size_desktop",
          "min": 16,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "PC端标题字体大小",
          "default": 28
        },
        {
          "type": "range",
          "id": "title_size_mobile",
          "min": 14,
          "max": 48,
          "step": 1,
          "unit": "px",
          "label": "移动端标题字体大小",
          "default": 22
        },
        {
          "type": "richtext",
          "id": "description",
          "default": "<p>描述文本内容，可以添加多行文本</p>",
          "label": "描述"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "查看更多",
          "label": "按钮文本"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "按钮链接"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "default": true,
