{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .stats-counter__container {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ section.settings.horizontal_alignment }};
    gap: 20px;
  }

  .stats-counter__item {
    flex: 1 1 100%;
    text-align: {{ section.settings.mobile_text_alignment }};
    margin-bottom: 20px;
  }

  @media screen and (min-width: 750px) {
    .stats-counter__item {
      flex: 1 1 calc(25% - 20px);
      max-width: calc(25% - 20px);
      text-align: {{ section.settings.desktop_text_alignment }};
    }
  }

  .stats-counter__title {
    margin-bottom: 10px;
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    color: {{ section.settings.title_color }};
  }

  .stats-counter__divider {
    width: {{ section.settings.divider_width }}%;
    margin: 10px;
    margin-left: {{ section.settings.mobile_text_alignment | replace: 'center', 'auto' | replace: 'left', '0' | replace: 'right', 'auto' }};
    margin-right: {{ section.settings.mobile_text_alignment | replace: 'center', 'auto' | replace: 'left', 'auto' | replace: 'right', '0' }};
    display: block !important;
    border-top: {{ section.settings.divider_thickness }}px solid {{ section.settings.divider_color }};
  }

  .stats-counter__content {
    line-height:normal;
  }

  @media screen and (min-width: 750px) {
    .stats-counter__divider {
      margin-left: {{ section.settings.desktop_text_alignment | replace: 'center', 'auto' | replace: 'left', '0' | replace: 'right', 'auto' }};
      margin-right: {{ section.settings.desktop_text_alignment | replace: 'center', 'auto' | replace: 'left', 'auto' | replace: 'right', '0' }};
    }
  }

  .stats-counter__value {
    font-size: {{ section.settings.value_font_size }}px;
    font-weight: {{ section.settings.value_font_weight }};
  }

  .stats-counter__suffix {
    font-size: {{ section.settings.suffix_font_size }}px;
    font-weight: {{ section.settings.suffix_font_weight }};
    vertical-align: {{ section.settings.suffix_align }};
  }

  .stats-counter__value, .stats-counter__suffix {
    line-height:1;
    display: inline-block;
  }
{%- endstyle -%}

<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
  <div class="stats-counter content-container color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} stats-counter--full-width content-container--full-width{% endif %} section-{{ section.id }}-padding">
    <div class="stats-counter__wrapper{% if section.settings.full_width %} page-width{% endif %}">
      <div class="stats-counter__container">
        {%- for block in section.blocks -%}
          <div class="stats-counter__item" {{ block.shopify_attributes }}>
            <div class="stats-counter__title">{{ block.settings.title }}</div>
            <div class="stats-counter__divider"></div>
            <div class="stats-counter__content">
              <span class="stats-counter__value">{{ block.settings.value }}</span>
              <span class="stats-counter__suffix">{{ block.settings.suffix }}</span>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "统计计数器",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "颜色方案",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "全宽显示"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "居左"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "flex-end",
          "label": "居右"
        }
      ],
      "default": "center",
      "label": "水平对齐方式"
    },
    {
      "type": "select",
      "id": "desktop_text_alignment",
      "options": [
        {
          "value": "left",
          "label": "居左"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "right",
          "label": "居右"
        }
      ],
      "default": "center",
      "label": "桌面端文本对齐方式"
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "options": [
        {
          "value": "left",
          "label": "居左"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "right",
          "label": "居右"
        }
      ],
      "default": "center",
      "label": "移动端文本对齐方式"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "标题字体大小",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "label": "标题字体粗细",
      "default": 400
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "divider_width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "分割线宽度",
      "default": 80
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "分割线粗细",
      "default": 1
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "分割线颜色",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "value_font_size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "数值字体大小",
      "default": 36
    },
    {
      "type": "range",
      "id": "value_font_weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "label": "数值字体粗细",
      "default": 700
    },
    {
      "type": "range",
      "id": "suffix_font_size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "后缀字体大小",
      "default": 18
    },
    {
      "type": "range",
      "id": "suffix_font_weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "label": "后缀字体粗细",
      "default": 400
    },
    {
      "type": "select",
      "id": "suffix_align",
      "options": [
        {
          "value": "baseline",
          "label": "基线对齐"
        },
        {
          "value": "top",
          "label": "顶部对齐"
        },
        {
          "value": "super",
          "label": "中部对齐"
        },
        {
          "value": "middle",
          "label": "底部对齐"
        }
      ],
      "default": "baseline",
      "label": "后缀对齐方式"
    },
    {
      "type": "header",
      "content": "内边距设置"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "顶部内边距",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "底部内边距",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "stat_item",
      "name": "统计项",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "标题文本"
        },
        {
          "type": "text",
          "id": "value",
          "label": "数值",
          "default": "100"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "后缀",
          "default": "+"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "统计计数器",
      "blocks": [
        {
          "type": "stat_item",
          "settings": {
            "title": "2025年",
            "value": "28",
            "suffix": "届"
          }
        },
        {
          "type": "stat_item",
          "settings": {
            "title": "预计参展商",
            "value": "2,800",
            "suffix": "+"
          }
        },
        {
          "type": "stat_item",
          "settings": {
            "title": "预计入场人士",
            "value": "70,000",
            "suffix": ""
          }
        },
        {
          "type": "stat_item",
          "settings": {
            "title": "国家及团体展馆",
            "value": "18",
            "suffix": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
