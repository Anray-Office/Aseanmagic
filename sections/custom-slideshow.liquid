{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}

<style>
  .custom-slideshow__arrow {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .custom-slideshow__arrow svg {
    width: 24px;
    height: 24px;
  }
  
  .custom-slideshow__arrow--prev svg {
    transform: scaleX(-1); /* 水平翻转SVG实现左箭头 */
  }
  
  .custom-slideshow__background {
    position: relative;
  }
  
  .custom-slideshow__background::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: {{ section.settings.background_color }};
    z-index: -1;
  }
  
  .slideshow__slide-link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  
  @media screen and (max-width: 749px) {
    .custom-slideshow__mobile-image {
      display: block;
    }
    .custom-slideshow__desktop-image {
      display: none;
    }
  }
  
  @media screen and (min-width: 750px) {
    .custom-slideshow__mobile-image {
      display: none;
    }
    .custom-slideshow__desktop-image {
      display: block;
    }
  }
</style>

{%- if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.desktop_image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before,
      #Slider-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.mobile_image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before {
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.desktop_image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

<slideshow-component
  class="custom-slideshow slider-mobile-gutter{% if section.settings.layout == 'grid' %} page-width{% endif %}{% if section.settings.show_text_below %} mobile-text-below{% endif %} custom-slideshow__background"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  {%- if section.settings.auto_rotate and section.blocks.size > 1 -%}
    <div class="slideshow__controls slideshow__controls--top slider-buttons{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
      <button
        type="button"
        class="slider-button slider-button--prev custom-slideshow__arrow custom-slideshow__arrow--prev"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="custom-svg-wrapper">
          <svg t="1755497175798" class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="12339" width="256" height="256">
            <path d="M352 256l231.19 256L352 768h152.82L736 512 504.78 256z" fill="{{ section.settings.arrow_color }}" p-id="12340"></path>
            <path d="M512 0C229.23 0 0 229.23 0 512s229.23 512 512 512 512-229.23 512-512S794.77 0 512 0z m0 928C282.62 928 96 741.38 96 512S282.62 96 512 96s416 186.62 416 416-186.62 416-416 416z" fill="{{ section.settings.arrow_color }}" p-id="12341"></path>
          </svg>
        </span>
      </button>
      <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        {%- else -%}
          <div class="slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button
                class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                aria-controls="Slider-{{ section.id }}"
              >
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index -}}
                {%- else -%}
                  <span class="dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <button
        type="button"
        class="slider-button slider-button--next custom-slideshow__arrow custom-slideshow__arrow--next"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="custom-svg-wrapper">
          <svg t="1755497175798" class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="12339" width="256" height="256">
            <path d="M352 256l231.19 256L352 768h152.82L736 512 504.78 256z" fill="{{ section.settings.arrow_color }}" p-id="12340"></path>
            <path d="M512 0C229.23 0 0 229.23 0 512s229.23 512 512 512 512-229.23 512-512S794.77 0 512 0z m0 928C282.62 928 96 741.38 96 512S282.62 96 512 96s416 186.62 416 416-186.62 416-416 416z" fill="{{ section.settings.arrow_color }}" p-id="12341"></path>
          </svg>
        </span>
      </button>

      {%- if section.settings.auto_rotate -%}
        <button
          type="button"
          class="slideshow__autoplay slider-button{% if section.settings.auto_rotate == false %} slideshow__autoplay--paused{% endif %}"
          aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-pause.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper">
            {{- 'icon-play.svg' | inline_asset_content -}}
          </span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div
    class="slideshow banner banner--{{ section.settings.slide_height }} grid grid--1-col slider slider--everywhere{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}{% if section.blocks.first.settings.desktop_image == blank %} slideshow--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    id="Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed }}"
    data-loop="{{ section.settings.enable_loop }}"
  >
    {%- for block in section.blocks -%}
      <div
        class="slideshow__slide grid__item grid--1-col slider__slide"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
        tabindex="-1"
      >
        {% if block.settings.slide_link != blank %}
          <a href="{{ block.settings.slide_link }}" class="slideshow__slide-link">
        {% endif %}
        <div class="slideshow__media banner__media media">
          {%- if block.settings.desktop_image -%}
            <div class="custom-slideshow__desktop-image">
              {%- assign loading_attribute = 'lazy' -%}
              {%- if forloop.first -%}
                {%- assign loading_attribute = 'eager' -%}
              {%- endif -%}
              {{
                block.settings.desktop_image
                | image_url: width: 3840
                | image_tag: loading: loading_attribute, class: 'desktop-image'
              }}
            </div>
            <div class="custom-slideshow__mobile-image">
              {{
                block.settings.mobile_image | default: block.settings.desktop_image
                | image_url: width: 1100
                | image_tag: loading: loading_attribute, class: 'mobile-image'
              }}
            </div>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {% if block.settings.slide_link != blank %}
          </a>
        {% endif %}
        
        {%- if block.settings.show_text -%}
          <div class="slideshow__text-wrapper banner__content banner__content--{{ block.settings.box_align }} page-width{% if block.settings.show_text_box == false %} banner--desktop-transparent{% endif %}">
            <div class="slideshow__text banner__box content-container content-container--full-width-mobile color-{{ block.settings.color_scheme }} gradient slideshow__text--{{ block.settings.text_alignment }} slideshow__text-mobile--{{ block.settings.text_alignment_mobile }}">
              {%- if block.settings.heading != blank -%}
                <h2 class="banner__heading inline-richtext {{ block.settings.heading_size }}">
                  {{ block.settings.heading }}
                </h2>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <div class="banner__text rte">
                  <p>{{ block.settings.subheading }}</p>
                </div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <div class="banner__buttons">
                  <a
                    {% if block.settings.link %}
                      href="{{ block.settings.link }}"
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                    class="button {% if block.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}"
                  >
                    {{- block.settings.button_label | escape -}}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 and section.settings.auto_rotate == false -%}
    <div class="slideshow__controls slider-buttons{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
      <button
        type="button"
        class="slider-button slider-button--prev custom-slideshow__arrow custom-slideshow__arrow--prev"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="custom-svg-wrapper">
          <svg t="1755497175798" class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="12339" width="256" height="256">
            <path d="M352 256l231.19 256L352 768h152.82L736 512 504.78 256z" fill="{{ section.settings.arrow_color }}" p-id="12340"></path>
            <path d="M512 0C229.23 0 0 229.23 0 512s229.23 512 512 512 512-229.23 512-512S794.77 0 512 0z m0 928C282.62 928 96 741.38 96 512S282.62 96 512 96s416 186.62 416 416-186.62 416-416 416z" fill="{{ section.settings.arrow_color }}" p-id="12341"></path>
          </svg>
        </span>
      </button>
      <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        {%- else -%}
          <div class="slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button
                class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                aria-controls="Slider-{{ section.id }}"
              >
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index -}}
                {%- else -%}
                  <span class="dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <button
        type="button"
        class="slider-button slider-button--next custom-slideshow__arrow custom-slideshow__arrow--next"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="custom-svg-wrapper">
          <svg t="1755497175798" class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="12339" width="256" height="256">
            <path d="M352 256l231.19 256L352 768h152.82L736 512 504.78 256z" fill="{{ section.settings.arrow_color }}" p-id="12340"></path>
            <path d="M512 0C229.23 0 0 229.23 0 512s229.23 512 512 512 512-229.23 512-512S794.77 0 512 0z m0 928C282.62 928 96 741.38 96 512S282.62 96 512 96s416 186.62 416 416-186.62 416-416 416z" fill="{{ section.settings.arrow_color }}" p-id="12341"></path>
          </svg>
        </span>
      </button>
    </div>
  {%- endif -%}
</slideshow-component>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "custom-slideshow",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "full_bleed",
          "label": "全出血"
        },
        {
          "value": "grid",
          "label": "网格"
        }
      ],
      "default": "full_bleed",
      "label": "布局"
    },
    {
      "type": "select",
      "id": "slide_height",
      "options": [
        {
          "value": "adapt_image",
          "label": "适应图片"
        },
        {
          "value": "small",
          "label": "小"
        },
        {
          "value": "medium",
          "label": "中"
        },
        {
          "value": "large",
          "label": "大"
        }
      ],
      "default": "medium",
      "label": "幻灯片高度"
    },
    {
      "type": "select",
      "id": "slider_visual",
      "options": [
        {
          "value": "dots",
          "label": "圆点"
        },
        {
          "value": "counter",
          "label": "计数器"
        },
        {
          "value": "numbers",
          "label": "数字"
        }
      ],
      "default": "counter",
      "label": "滑块可视化"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "自动轮播",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "秒",
      "label": "幻灯片自动切换速度",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "启用无限循环",
      "default": true
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "箭头颜色",
      "default": "#C32F26"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_text_below",
      "label": "在移动端下方显示文本",
      "default": true
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "无障碍描述",
      "default": "轮播图"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "幻灯片",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "桌面端图片"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "移动端图片"
        },
        {
          "type": "url",
          "id": "slide_link",
          "label": "幻灯片链接",
          "info": "设置链接使整个幻灯片可点击，不设置则不可点击"
        },
        {
          "type": "checkbox",
          "id": "show_text",
          "label": "显示文本",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_text_box",
          "label": "显示文本框",
          "default": true
        },
        {
          "type": "select",
          "id": "box_align",
          "options": [
            {
              "value": "top-left",
              "label": "左上"
            },
            {
              "value": "top-center",
              "label": "顶部居中"
            },
            {
              "value": "top-right",
              "label": "右上"
            },
            {
              "value": "middle-left",
              "label": "左中"
            },
            {
              "value": "middle-center",
              "label": "中间"
            },
            {
              "value": "middle-right",
              "label": "右中"
            },
            {
              "value": "bottom-left",
              "label": "左下"
            },
            {
              "value": "bottom-center",
              "label": "底部居中"
            },
            {
              "value": "bottom-right",
              "label": "右下"
            }
          ],
          "default": "middle-center",
          "label": "文本框位置"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "options": [
            {
              "value": "left",
              "label": "左对齐"
            },
            {
              "value": "center",
              "label": "居中"
            },
            {
              "value": "right",
              "label": "右对齐"
            }
          ],
          "default": "center",
          "label": "文本对齐"
        },
        {
          "type": "select",
          "id": "text_alignment_mobile",
          "options": [
            {
              "value": "left",
              "label": "左对齐"
            },
            {
              "value": "center",
              "label": "居中"
            },
            {
              "value": "right",
              "label": "右对齐"
            }
          ],
          "default": "center",
          "label": "移动端文本对齐"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "图片幻灯片",
          "label": "标题"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "h2"
            },
            {
              "value": "h1",
              "label": "h1"
            },
            {
              "value": "h0",
              "label": "h0"
            },
            {
              "value": "hxl",
              "label": "特大"
            },
            {
              "value": "hxxl",
              "label": "超大"
            }
          ],
          "default": "h1",
          "label": "标题大小"
        },
        {
          "type": "inline_richtext",
          "id": "subheading",
          "default": "使用幻灯片展示文本和图片",
          "label": "副标题"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "按钮标签",
          "label": "按钮文本"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "label": "使用次要按钮样式",
          "default": false
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "颜色方案",
          "default": "scheme-1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "custom-slideshow",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
