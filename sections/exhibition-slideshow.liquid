{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .exhibition-slideshow {
    --exhibition-slide-height: 500px;
  }

  @media screen and (min-width: 750px) {
    .exhibition-slideshow {
      --exhibition-slide-height: 650px;
    }
  }

  .exhibition-slide {
    display: flex;
    position: relative;
    height: var(--exhibition-slide-height);
    overflow: hidden;
  }

  .exhibition-slide__image-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .exhibition-slide__image {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .exhibition-slide__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    background-color: rgba(var(--color-overlay), var(--overlay-opacity));
  }

  .exhibition-slide__content-wrapper {
    position: relative;
    z-index: 3;
    display: flex;
    width: 100%;
    padding: 3rem;
  }

  .exhibition-slide__content {
    display: flex;
    flex-direction: column;
    max-width: 50%;
    padding: 2rem;
  }

  .exhibition-slide__content--{{ section.settings.content_position }} {
    {% if section.settings.content_position == 'left' %}
      align-items: flex-start;
      text-align: left;
      margin-right: auto;
    {% elsif section.settings.content_position == 'center' %}
      align-items: center;
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    {% else %}
      align-items: flex-end;
      text-align: right;
      margin-left: auto;
    {% endif %}
  }

  .exhibition-slide__event-info {
    display: flex;
    flex-direction: column;
    margin-left: auto;
    text-align: right;
    max-width: 45%;
  }

  .exhibition-main-heading {
    font-size: calc(var(--font-heading-scale) * 3.2rem);
    margin-bottom: 1.5rem;
    color: {{ section.settings.heading_color }};
  }

  .exhibition-subheading {
    font-size: calc(var(--font-heading-scale) * 2.4rem);
    margin-bottom: 2rem;
    color: {{ section.settings.subheading_color }};
  }

  .exhibition-description {
    margin-bottom: 2rem;
    color: {{ section.settings.text_color }};
  }

  .exhibition-button {
    display: inline-block;
    padding: 1rem 2rem;
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    text-transform: uppercase;
    font-weight: bold;
    margin-top: 1.5rem;
    transition: transform 0.3s ease;
  }

  .exhibition-button:hover {
    transform: scale(1.05);
  }

  .exhibition-event-title {
    font-size: calc(var(--font-heading-scale) * 1.8rem);
    font-weight: bold;
    color: {{ section.settings.event_title_color }};
    margin-bottom: 0.5rem;
  }

  .exhibition-event-date {
    font-size: calc(var(--font-heading-scale) * 1.5rem);
    font-weight: bold;
    color: {{ section.settings.event_info_color }};
    margin-bottom: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: {{ section.settings.date_background_color }};
    display: inline-block;
    margin-left: auto;
  }

  .exhibition-event-location {
    font-size: calc(var(--font-heading-scale) * 1.4rem);
    color: {{ section.settings.event_info_color }};
    margin-bottom: 1rem;
  }

  .exhibition-event-logo {
    max-width: 250px;
    margin-left: auto;
    margin-bottom: 1rem;
  }

  @media screen and (max-width: 749px) {
    .exhibition-slide__content-wrapper {
      flex-direction: column;
      padding: 2rem;
    }

    .exhibition-slide__content, 
    .exhibition-slide__event-info {
      max-width: 100%;
      text-align: center;
      align-items: center;
      margin: 0 auto;
    }

    .exhibition-slide__event-info {
      margin-top: 2rem;
      align-items: center;
    }

    .exhibition-main-heading {
      font-size: calc(var(--font-heading-scale) * 2.4rem);
    }

    .exhibition-subheading {
      font-size: calc(var(--font-heading-scale) * 1.8rem);
    }

    .exhibition-event-title {
      font-size: calc(var(--font-heading-scale) * 1.5rem);
    }

    .exhibition-event-date,
    .exhibition-event-location {
      font-size: calc(var(--font-heading-scale) * 1.2rem);
    }

    .exhibition-event-logo {
      margin: 0 auto 1rem;
    }
  }
{%- endstyle -%}

<slideshow-component
  class="exhibition-slideshow slider-mobile-gutter{% if section.settings.layout == 'grid' %} page-width{% endif %}{% if section.settings.show_text_below %} mobile-text-below{% endif %}"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  {%- if section.settings.auto_rotate and section.blocks.size > 1 -%}
    <div class="slideshow__controls slideshow__controls--top slider-buttons{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
      <button
        type="button"
        class="slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
      <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        {%- else -%}
          <div class="slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button
                class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                aria-controls="Slider-{{ section.id }}"
              >
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index -}}
                {%- else -%}
                  <span class="dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <button
        type="button"
        class="slider-button slider-button--next"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      {%- if section.settings.auto_rotate -%}
        <button
          type="button"
          class="slideshow__autoplay slider-button{% if section.settings.auto_rotate == false %} slideshow__autoplay--paused{% endif %}"
          aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-pause.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper">
            {{- 'icon-play.svg' | inline_asset_content -}}
          </span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div
    class="slideshow banner grid grid--1-col slider slider--everywhere"
    id="Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed }}"
    data-loop="{{ section.settings.enable_loop }}"
  >
    {%- for block in section.blocks -%}
      <style>
        #Slide-{{ section.id }}-{{ forloop.index }} .exhibition-slide__overlay {
          opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
          background-color: {{ block.settings.overlay_color }};
        }
      </style>
      <div
        class="exhibition-slide slideshow__slide grid__item grid--1-col slider__slide"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
        tabindex="-1"
      >
        <div class="exhibition-slide__image-container">
          {%- if block.settings.image != blank -%}
            {%- liquid
              assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
              assign sizes = '100vw'
              assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
              assign fetch_priority = 'auto'
              if section.index == 1
                assign fetch_priority = 'high'
              endif
            -%}
            {%- if forloop.first %}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag: 
                    height: height, 
                    sizes: sizes, 
                    widths: widths, 
                    fetchpriority: fetch_priority,
                    class: 'exhibition-slide__image',
                    alt: block.settings.image.alt | escape
              }}
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag: 
                    loading: 'lazy', 
                    height: height, 
                    sizes: sizes, 
                    widths: widths,
                    class: 'exhibition-slide__image',
                    alt: block.settings.image.alt | escape
              }}
            {%- endif -%}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg exhibition-slide__image' }}
          {%- endif -%}
        </div>

        <div class="exhibition-slide__overlay" style="background-color: {{ block.settings.overlay_color }}"></div>

        <div class="exhibition-slide__content-wrapper">
          <div class="exhibition-slide__content exhibition-slide__content--{{ block.settings.content_position }}">
            {%- if block.settings.heading != blank -%}
              <h2 class="exhibition-main-heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            
            {%- if block.settings.subheading != blank -%}
              <h3 class="exhibition-subheading">{{ block.settings.subheading }}</h3>
            {%- endif -%}
            
            {%- if block.settings.description != blank -%}
              <div class="exhibition-description">
                {{ block.settings.description }}
              </div>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              <a 
                href="{{ block.settings.button_link }}" 
                class="exhibition-button"
                {% if block.settings.button_link == blank %}aria-disabled="true"{% endif %}
              >
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>

          <div class="exhibition-slide__event-info">
            {%- if block.settings.event_logo != blank -%}
              {{
                block.settings.event_logo
                | image_url: width: 350
                | image_tag: 
                    loading: 'lazy',
                    width: 250, 
                    class: 'exhibition-event-logo',
                    alt: block.settings.event_logo.alt | escape
              }}
            {%- endif -%}

            {%- if block.settings.event_location != blank -%}
              <div class="exhibition-event-location">{{ block.settings.event_location }}</div>
            {%- endif -%}

            {%- if block.settings.event_date != blank -%}
              <div class="exhibition-event-date">{{ block.settings.event_date }}</div>
            {%- endif -%}

            {%- if block.settings.event_title != blank -%}
              <div class="exhibition-event-title">{{ block.settings.event_title }}</div>
            {%- endif -%}

            {%- if block.settings.secondary_event_date != blank -%}
              <div class="exhibition-event-date">{{ block.settings.secondary_event_date }}</div>
            {%- endif -%}

            {%- if block.settings.secondary_event_location != blank -%}
              <div class="exhibition-event-location">{{ block.settings.secondary_event_location }}</div>
            {%- endif -%}

            {%- if block.settings.secondary_event_logo != blank -%}
              {{
                block.settings.secondary_event_logo
                | image_url: width: 350
                | image_tag: 
                    loading: 'lazy',
                    width: 250, 
                    class: 'exhibition-event-logo',
                    alt: block.settings.secondary_event_logo.alt | escape
              }}
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 and section.settings.auto_rotate == false -%}
    <div class="slideshow__controls slider-buttons{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
      <button
        type="button"
        class="slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
      <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        {%- else -%}
          <div class="slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button
                class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                aria-controls="Slider-{{ section.id }}"
              >
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index -}}
                {%- else -%}
                  <span class="dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <button
        type="button"
        class="slider-button slider-button--next"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>
  {%- endif -%}
</slideshow-component>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "custom-slide",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "full_bleed",
          "label": "全宽显示"
        },
        {
          "value": "grid",
          "label": "网格内显示"
        }
      ],
      "default": "full_bleed",
      "label": "布局"
    },
    {
      "type": "select",
      "id": "content_position",
      "options": [
        {
          "value": "left",
          "label": "左侧"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "right",
          "label": "右侧"
        }
      ],
      "default": "left",
      "label": "内容位置"
    },
    {
      "type": "select",
      "id": "slider_visual",
      "options": [
        {
          "value": "dots",
          "label": "圆点"
        },
        {
          "value": "counter",
          "label": "计数器"
        },
        {
          "value": "numbers",
          "label": "数字"
        }
      ],
      "default": "counter",
      "label": "滑块显示样式"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "自动轮播",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 2,
      "unit": "秒",
      "label": "自动轮播间隔",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "启用无限循环",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_text_below",
      "label": "在移动设备上在图片下方显示内容",
      "default": true
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "标题颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "副标题颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文本颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "按钮背景色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "按钮文字颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "event_title_color",
      "label": "展会标题颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "event_info_color",
      "label": "展会信息颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "date_background_color",
      "label": "日期背景颜色",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "轮播图无障碍描述",
      "info": "描述此轮播图的内容，供使用屏幕阅读器的用户使用",
      "default": "展会轮播图"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "轮播项",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "背景图片"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "背景遮罩颜色",
          "default": "#cc0000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "遮罩不透明度",
          "default": 30
        },
        {
          "type": "select",
          "id": "content_position",
          "options": [
            {
              "value": "left",
              "label": "左侧"
            },
            {
              "value": "center",
              "label": "居中"
            },
            {
              "value": "right",
              "label": "右侧"
            }
          ],
          "default": "left",
          "label": "内容位置"
        },
        {
          "type": "header",
          "content": "主要内容"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "助您拓展美业版图",
          "label": "标题"
        },
        {
          "type": "text",
          "id": "subheading",
          "default": "业务发展更上一层楼",
          "label": "副标题"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "描述"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "立即登记",
          "label": "按钮文字"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "按钮链接"
        },
        {
          "type": "header",
          "content": "展会信息"
        },
        {
          "type": "image_picker",
          "id": "event_logo",
          "label": "展会标志"
        },
        {
          "type": "text",
          "id": "event_title",
          "default": "中国香港",
          "label": "展会标题"
        },
        {
          "type": "text",
          "id": "event_date",
          "default": "2025年11月11-13日",
          "label": "展会日期"
        },
        {
          "type": "text",
          "id": "event_location",
          "default": "亚洲国际博览馆",
          "label": "展会地点"
        },
        {
          "type": "header",
          "content": "次要展会信息"
        },
        {
          "type": "image_picker",
          "id": "secondary_event_logo",
          "label": "次要展会标志"
        },
        {
          "type": "text",
          "id": "secondary_event_date",
          "default": "2025年11月12-14日",
          "label": "次要展会日期"
        },
        {
          "type": "text",
          "id": "secondary_event_location",
          "default": "香港会议展览中心",
          "label": "次要展会地点"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "custom-slide",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "助您拓展美业版图",
            "subheading": "业务发展更上一层楼",
            "button_label": "立即登记",
            "event_title": "中国香港",
            "event_date": "2025年11月11-13日",
            "event_location": "亚洲国际博览馆",
            "overlay_color": "#cc0000",
            "overlay_opacity": 30
          }
        }
      ]
    }
  ]
}
{% endschema %}
