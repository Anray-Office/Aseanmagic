            "custom_hover_border_color": "#000000"
          }
        },
        "text_item_n6JnyB": {
          "type": "text_item",
          "settings": {
            "bg_color": "#f8eae0",
            "title": "记录",
            "title_tag": "h3",
            "title_size_desktop": 28,
            "title_size_mobile": 22,
            "description": "<p>收录的精彩瞬间，既是本次活动的美好回忆，更是中东盟文化交流不断深入的生动见证。愿这一页页图文，记录的不只是艺术的光芒，更是各国人民心与心的连接与共鸣。</p><p>让我们以文化为媒，以艺术为桥，携手走向更加紧密、夏加美好的未来。</p>",
            "button_label": "查看更多",
